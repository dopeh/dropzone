{
  "name": "dropzone-exercise",
  "version": "1.0.0",
  "private": true,
  "description": "Interview exercise starter: a small file processing pipeline",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch src/server.ts\" \"vite\"",
    "build": "vite build && tsc",
    "start": "tsx src/server.ts"
  },
  "dependencies": {
    "@uppy/core": "6.3.0",
    "@uppy/thumbnail-generator": "6.0.1",
    "@uppy/xhr-upload": "6.0.1",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "file-type": "^19.0.0",
    "sharp": "^0.33.4",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.2",
    "@vitejs/plugin-vue": "6.0.10",
    "concurrently": "10.0.6",
    "tsx": "^4.15.6",
    "typescript": "^5.5.2",
    "vite": "8.3.4"
  }
}
